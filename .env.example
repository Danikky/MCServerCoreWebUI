# Скопируй в .env и заполни под себя (файл .env — в .gitignore, не коммитится).
# Всё опционально: без .env приложение стартует с безопасными дефолтами для
# локальной разработки (кроме ALLOW_REGISTRATION — он и так по умолчанию 0).

# Ключ для подписи сессий/кук. Если не задать — сгенерируется один раз и
# сохранится в .flask_secret_key рядом с проектом (тоже в .gitignore).
# На проде лучше задавать явно: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Логин/пароль первого администратора, создаётся один раз при пустой таблице
# пользователей. Если ADMIN_PASSWORD не задан — пароль сгенерируется случайно
# и один раз выводится в консоль при первом старте.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Публичная регистрация новых пользователей выключена по умолчанию — без
# ролей это прямой путь к полному доступу для кого угодно. Включай только
# если понимаешь последствия.
ALLOW_REGISTRATION=0

# debug=True у Flask/Werkzeug — НЕ для прода (даёт исполнение кода через
# браузер). 1 — включить, любое другое значение/пусто — выключено.
MCSC_DEBUG=0

# На чём слушать веб-сервер.
MCSC_HOST=0.0.0.0
MCSC_PORT=5245

# Разрешённые origin для WebSocket (Socket.IO). "*" — для локальной разработки;
# на проде укажи конкретный домен, например https://your-domain.com
MCSC_CORS_ORIGINS=*

# Дефолты для памяти JVM новых серверов (у каждого сервера свои Xmx/Xms,
# задаются при создании в UI — это только значения по умолчанию в форме).
MCSC_JAVA_XMX=2G
MCSC_JAVA_XMS=1G

# Лимит на загрузку файлов через веб (в первую очередь — ядро сервера,
# /servers/<id>/core/upload), в мегабайтах.
MCSC_MAX_UPLOAD_MB=4096
